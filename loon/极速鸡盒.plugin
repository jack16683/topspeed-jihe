#!name = 极速鸡盒
#!desc = 知道你的鸡盒到底有多快
#!author = jack16683
#!homepage = https://github.com/jack16683/topspeed-jihe
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-21
#!tag = 鸡盒,骑行,统计

[Argument]
brakeMode = select,"严格G","云端近似",type=string,tag=急刹统计方式,desc=严格G仅在采样足够时判定；云端近似按历史计数拟合并回填估算
bendMode = select,"日常估算","保守估算",type=string,tag=压弯估算方式,desc=日常按采样等效5度筛选；保守按10度筛选；均非实测倾角

[Script]
response if ${url} ~= /^https:\/\/tapi\.zeehoev\.com\/v1\.0\/app\/cfmotoserverapp\/(?:[^/?#]+\/)*(?:vehicleHomePageV2(?:\/[^/?#]+)?|vehicle\/list|ridetrack_v2|myRideInfo|homeRideInfo|analyse)(?:\?|$)/ then script("https://raw.githubusercontent.com/jack16683/topspeed-jihe/v2.1.1/loon/scripts/ride-fill.js", {${brakeMode}, ${bendMode}}) with tag="极速鸡盒 统计补全", requires_body=true, timeout=30
generic then script("https://raw.githubusercontent.com/jack16683/topspeed-jihe/v2.1.1/loon/scripts/cache-tools.js", "status") with tag="极速鸡盒 查看缓存", timeout=10
generic then script("https://raw.githubusercontent.com/jack16683/topspeed-jihe/v2.1.1/loon/scripts/cache-tools.js", "clear") with tag="极速鸡盒 清空缓存", timeout=10

[Mitm]
hostname = tapi.zeehoev.com
